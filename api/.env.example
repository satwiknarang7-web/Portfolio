# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# Where messages are stored. Defaults to data/messages.db locally and /tmp on Vercel.
# DATABASE_PATH=data/messages.db
# Requests allowed per client IP per window
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Optional: forward each message to your inbox. Leave SMTP_HOST empty to only store messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_INBOX=
