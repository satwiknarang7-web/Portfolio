# Base URL of the Python FastAPI service (called server-side only, never exposed to the browser)
CONTACT_API_URL=http://127.0.0.1:8000
# Public URL of this site (metadata, sitemap, robots.txt). Optional on Vercel, which provides it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Web3Forms access key (free, from web3forms.com) — emails each contact message to you.
# Public by design; it can only send to the inbox it was issued for.
NEXT_PUBLIC_WEB3FORMS_KEY=
